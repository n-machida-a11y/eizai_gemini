/**
 * 西日本衛材 売上分析システム
 *
 * 前提: ○当日販売実績報告.xlsx をGoogle Sheetsに変換済み
 *       （数式はそのまま保持される）
 *
 * 運用: 受信フォルダに3つのExcelを置く → 自動でWEB-reportに反映
 *       → 式・送付用シートが自動計算 → 蓄積シートに履歴追記
 */

// ============================================================
//  設定
// ============================================================
const CONFIG_SHEET = '設定';

function getConfig_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(CONFIG_SHEET);
  if (!sheet) return {};
  const data = sheet.getDataRange().getValues();
  const config = {};
  for (let i = 1; i < data.length; i++) {
    config[data[i][0]] = data[i][1];
  }
  return config;
}

// ============================================================
//  メニュー
// ============================================================
function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('売上分析')
    .addItem('Excelを取込（受信フォルダから）', 'importFromDrive')
    .addSeparator()
    .addItem('初期セットアップ', 'setupSystem')
    .addItem('自動取込を開始（5分おき）', 'startAutoImport')
    .addItem('自動取込を停止', 'stopAutoImport')
    .addToUi();
}

// ============================================================
//  Webアプリ
// ============================================================
function doGet() {
  return HtmlService.createHtmlOutputFromFile('Dashboard')
    .setTitle('西日本衛材 売上ダッシュボード')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

// ============================================================
//  自動取込トリガー
// ============================================================
function startAutoImport() {
  stopAutoImport(); // 既存トリガー削除
  ScriptApp.newTrigger('importFromDrive')
    .timeBased()
    .everyMinutes(5)
    .create();
  SpreadsheetApp.getUi().alert('自動取込を開始しました（5分おき）\n受信フォルダにExcelを置くと自動で処理されます。');
}

function stopAutoImport() {
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(t => {
    if (t.getHandlerFunction() === 'importFromDrive') {
      ScriptApp.deleteTrigger(t);
    }
  });
}

// ============================================================
//  ダッシュボード用データAPI
// ============================================================
function getDashboardData() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    if (!ss) throw new Error('getActiveSpreadsheet() が null');
    const result = {
      current: _getCurrentData(ss),
      salesHistory: _getHistory(ss, '蓄積_売上'),
      shipmentHistory: _getHistory(ss, '蓄積_出荷'),
      inventoryHistory: _getHistory(ss, '蓄積_在庫'),
      targetHistory: _getHistory(ss, '蓄積_目標'),
      allDates: _getAllDates(ss),
    };
    // google.script.run の転送で落ちないようJSON経由で正規化
    const json = JSON.stringify(result);
    console.log('[getDashboardData] 戻り値サイズ: ' + json.length + ' 文字');
    return JSON.parse(json);
  } catch (e) {
    console.error('[getDashboardData] エラー: ' + e.message);
    throw e;
  }
}

function getDataForDate(date) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const result = {
    current: _getHistoricalData(ss, date),
    salesHistory: _getHistory(ss, '蓄積_売上'),
    shipmentHistory: _getHistory(ss, '蓄積_出荷'),
    allDates: _getAllDates(ss),
  };
  return JSON.parse(JSON.stringify(result));
}

function _getCurrentData(ss) {
  // 式シートから現在の計算値を取得
  const formula = ss.getSheetByName('式');
  if (!formula) return null;

  const webReport = ss.getSheetByName('WEB-report');

  // 出荷データ（WEB-report H3:J17）
  const shipments = [];
  if (webReport) {
    for (let r = 3; r <= 17; r++) {
      const name = webReport.getRange(r, 9).getValue(); // I列
      const cases = webReport.getRange(r, 10).getValue(); // J列
      if (name && cases) shipments.push({ name: _normalize(String(name)), cases: Number(cases) || 0 });
    }
  }

  // 在庫データ（WEB-report B25:L37 → 式シート E20:J37）
  const detail = [];
  for (let r = 20; r <= 37; r++) {
    const key = formula.getRange(r, 2).getValue(); // B列
    if (!key) continue;
    detail.push({
      key: String(key),
      name: String(formula.getRange(r, 1).getValue() || ''),
      inventory: Number(formula.getRange(r, 5).getValue()) || 0,
      monthProd: Number(formula.getRange(r, 6).getValue()) || 0,
      monthShip: Number(formula.getRange(r, 7).getValue()) || 0,
      yearProd: Number(formula.getRange(r, 8).getValue()) || 0,
      yearShip: Number(formula.getRange(r, 9).getValue()) || 0,
      nextDay: Number(formula.getRange(r, 10).getValue()) || 0,
    });
  }

  return {
    reportDate: _fmtDate(formula.getRange('C3').getValue()),
    dailySales: Number(formula.getRange('C8').getValue()) || 0,
    dailyMerchandise: Number(formula.getRange('D8').getValue()) || 0,
    monthlySales: Number(formula.getRange('C9').getValue()) || 0,
    annualSales: Number(formula.getRange('C10').getValue()) || 0,
    annualDiscount: Number(formula.getRange('E10').getValue()) || 0,
    dailyTarget: Number(formula.getRange('C13').getValue()) || 0,
    monthlyTargetSofar: Number(formula.getRange('C14').getValue()) || 0,
    monthlyTarget: Number(formula.getRange('C15').getValue()) || 0,
    annualTarget: Number(formula.getRange('C16').getValue()) || 0,
    cumTarget: Number(formula.getRange('C17').getValue()) || 0,
    bizDaysMonth: Number(formula.getRange('G3').getValue()) || 0,
    bizDaysSofar: Number(formula.getRange('G4').getValue()) || 0,
    totalInventory: Number(formula.getRange('E38').getValue()) || 0,
    totalShipment: Number(formula.getRange('G38').getValue()) || 0,
    shipments: shipments,
    detail: detail,
  };
}

function _getHistoricalData(ss, date) {
  // 蓄積シートから特定日のデータを取得
  const result = { reportDate: date, shipments: [], detail: [] };

  const salesSheet = ss.getSheetByName('蓄積_売上');
  if (salesSheet && salesSheet.getLastRow() > 1) {
    const data = salesSheet.getDataRange().getValues();
    for (let i = 1; i < data.length; i++) {
      if (_fmtDate(data[i][0]) === date) {
        if (String(data[i][2]) === '総計') {
          result.dailySales = Number(data[i][3]) || 0;
          result.monthlySales = Number(data[i][4]) || 0;
          result.annualSales = Number(data[i][5]) || 0;
        }
      }
    }
  }

  const shipSheet = ss.getSheetByName('蓄積_出荷');
  if (shipSheet && shipSheet.getLastRow() > 1) {
    const data = shipSheet.getDataRange().getValues();
    for (let i = 1; i < data.length; i++) {
      if (_fmtDate(data[i][0]) === date) {
        result.shipments.push({ name: String(data[i][1]), cases: Number(data[i][2]) || 0 });
      }
    }
  }

  const targetSheet = ss.getSheetByName('蓄積_目標');
  if (targetSheet && targetSheet.getLastRow() > 1) {
    const data = targetSheet.getDataRange().getValues();
    for (let i = 1; i < data.length; i++) {
      if (_fmtDate(data[i][0]) === date) {
        result.dailyTarget = Number(data[i][4]) || 0;
        result.monthlyTargetSofar = Number(data[i][5]) || 0;
        result.monthlyTarget = Number(data[i][6]) || 0;
        result.annualTarget = Number(data[i][7]) || 0;
        result.cumTarget = Number(data[i][8]) || 0;
        break;
      }
    }
  }

  return result;
}

function _getHistory(ss, sheetName) {
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet || sheet.getLastRow() <= 1) return [];
  const data = sheet.getDataRange().getValues();
  const header = data[0];
  const rows = [];
  for (let i = 1; i < data.length; i++) {
    const row = {};
    for (let j = 0; j < header.length; j++) {
      row[header[j]] = data[i][j];
    }
    rows.push(row);
  }
  return rows;
}

function _getAllDates(ss) {
  const sheet = ss.getSheetByName('蓄積_売上');
  if (!sheet || sheet.getLastRow() <= 1) return [];
  const dates = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues().flat();
  const unique = [...new Set(dates.map(d => _fmtDate(d)))].filter(d => d);
  unique.sort();
  return unique;
}

function _fmtDate(v) {
  if (!v) return '';
  if (v instanceof Date) return Utilities.formatDate(v, 'Asia/Tokyo', 'yyyy-MM-dd');
  return String(v);
}

function _normalize(s) {
  if (!s) return '';
  // 全角→半角、パディング除去
  return s.normalize('NFKC').replace(/\s+/g, ' ').trim();
}
